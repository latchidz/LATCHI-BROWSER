<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════ LATCHI identity: deep navy + gold (brushes ONLY — the
         Color-vs-Brush crash class is guarded by XamlBrushTests) ═══════════════ -->

    <SolidColorBrush x:Key="BrushWindow" Color="#FF0B1220"/>
    <SolidColorBrush x:Key="BrushTabStrip" Color="#FF0A101F"/>
    <SolidColorBrush x:Key="BrushPanel" Color="#FF111A2E"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#FF22304F"/>
    <SolidColorBrush x:Key="BrushAccent" Color="#FFE3B341"/>
    <SolidColorBrush x:Key="BrushAccentDim" Color="#FF9C7A2A"/>
    <SolidColorBrush x:Key="BrushText" Color="#FFEAEFF9"/>
    <SolidColorBrush x:Key="BrushMuted" Color="#FF93A0B8"/>
    <SolidColorBrush x:Key="BrushHover" Color="#FF1B2947"/>
    <SolidColorBrush x:Key="BrushTabActive" Color="#FF1E2C4D"/>
    <SolidColorBrush x:Key="BrushField" Color="#FF0D1626"/>
    <SolidColorBrush x:Key="BrushContentBg" Color="#FF060B16"/>
    <SolidColorBrush x:Key="BrushDanger" Color="#FFE2574C"/>

    <!-- ═══════════════ icon buttons (toolbar / caption) — real hit areas, hover,
         pressed; every glyph is Segoe MDL2 (vector, §84 — no emoji icons) ═══════════════ -->
    <Style x:Key="ToolBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushTabActive}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- close button: same shape, danger hover -->
    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
        <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
    </Style>

    <!-- tab shape: rounded top corners, gold top line when active -->
    <Style x:Key="TabShape" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushPanel}"/>
        <Setter Property="CornerRadius" Value="8,8,0,0"/>
        <Setter Property="BorderThickness" Value="0,2,0,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushTabActive}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- address bar text -->
    <Style x:Key="AddressBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="CaretBrush" Value="{StaticResource BrushAccent}"/>
        <Setter Property="SelectionBrush" Value="#66E3B341"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="6,0"/>
    </Style>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════ LATCHI identity: deep navy + gold (brushes ONLY — the
         Color-vs-Brush crash class is guarded by XamlBrushTests) ═══════════════ -->

    <SolidColorBrush x:Key="BrushWindow" Color="#FF0B1220"/>
    <SolidColorBrush x:Key="BrushTabStrip" Color="#FF0A101F"/>
    <SolidColorBrush x:Key="BrushPanel" Color="#FF111A2E"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#FF22304F"/>
    <SolidColorBrush x:Key="BrushAccent" Color="#FFE3B341"/>
    <SolidColorBrush x:Key="BrushAccentDim" Color="#FF9C7A2A"/>
    <SolidColorBrush x:Key="BrushText" Color="#FFEAEFF9"/>
    <SolidColorBrush x:Key="BrushMuted" Color="#FF93A0B8"/>
    <SolidColorBrush x:Key="BrushHover" Color="#FF1B2947"/>
    <SolidColorBrush x:Key="BrushTabActive" Color="#FF1E2C4D"/>
    <SolidColorBrush x:Key="BrushField" Color="#FF0D1626"/>
    <SolidColorBrush x:Key="BrushContentBg" Color="#FF060B16"/>
    <SolidColorBrush x:Key="BrushDanger" Color="#FFE2574C"/>

    <!-- ═══════════════ icon buttons (toolbar / caption) — real hit areas, hover,
         pressed; every glyph is Segoe MDL2 (vector, §84 — no emoji icons) ═══════════════ -->
    <Style x:Key="ToolBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushTabActive}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- close button: same shape, danger hover -->
    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
        <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
    </Style>

    <!-- tab shape: rounded top corners, gold top line when active -->
    <Style x:Key="TabShape" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushPanel}"/>
        <Setter Property="CornerRadius" Value="8,8,0,0"/>
        <Setter Property="BorderThickness" Value="0,2,0,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushTabActive}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- address bar text -->
    <Style x:Key="AddressBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="CaretBrush" Value="{StaticResource BrushAccent}"/>
        <Setter Property="SelectionBrush" Value="#66E3B341"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="6,0"/>
    </Style>

    <!-- ═══════════════ rounds 2-7 shared styles ═══════════════ -->

    <!-- primary (gold) button: Save / Install / Send -->
    <Style x:Key="PrimaryBtn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
        <Setter Property="Foreground" Value="#FF141414"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushAccentDim}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- secondary (outline) button -->
    <Style x:Key="SecondaryBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- text "link-style" button used inside list rows -->
    <Style x:Key="LinkBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="11.5"/>
    </Style>

    <!-- bookmark chip on the bookmarks bar -->
    <Style x:Key="BookmarkChip" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="MaxWidth" Value="170"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="13">
                        <TextBlock Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrushTabActive}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- one selectable row in History/Bookmarks/Downloads/Extensions lists -->
    <Style x:Key="ListRow" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#16FFFFFF"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- dark input box for dialogs -->
    <Style x:Key="FieldBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushField}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="CaretBrush" Value="{StaticResource BrushAccent}"/>
        <Setter Property="SelectionBrush" Value="#66E3B341"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- settings section header -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Margin" Value="0,16,0,8"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- window title bar band for dialog windows -->
    <Style x:Key="DialogHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushTabStrip}"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>

    <Style x:Key="DialogHeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- small pill for status (downloads/extensions) -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushHover}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>

</ResourceDictionary>


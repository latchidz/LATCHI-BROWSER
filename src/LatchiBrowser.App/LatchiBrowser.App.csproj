<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Allows compile validation on non-Windows dev boxes; the real build always
         runs on windows-latest in GitHub Actions (§99 Release x64). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <!-- WinForms is used ONLY for FolderBrowserDialog (extension install picker) -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LATCHI-BROWSER</AssemblyName>
    <RootNamespace>LatchiBrowser.App</RootNamespace>
    <ApplicationIcon>..\..\assets\appicon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>LATCHI Browser</Product>
    <Company>LATCHI</Company>
    <Authors>LATCHI</Authors>
    <Description>Lightweight professional Windows browser (WebView2/Chromium) with multi Google profiles, extensions, downloads, bookmarks, history and a Gemini AI assistant.</Description>
    <Copyright>© 2026 LATCHI</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!-- DPAPI (CurrentUser) protection for the Gemini API key, §56/§57 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LatchiBrowser.Core\LatchiBrowser.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- window/taskbar icon resource + start-page/wizard logo -->
    <Resource Include="..\..\assets\appicon.ico" Link="assets\appicon.ico" />
    <Resource Include="..\..\assets\appicon-256.png" Link="assets\appicon-256.png" />
  </ItemGroup>

  <!-- WinForms is needed ONLY for FolderBrowserDialog; drop its implicit usings so
       WPF types (Application, KeyEventArgs…) never become ambiguous -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>

<Window x:Class="LatchiBrowser.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History"
        Width="760" Height="520" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushWindow}"
        FlowDirection="RightToLeft"
        Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DialogHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderTitle" Style="{StaticResource DialogHeaderText}"/>
                <Button x:Name="BtnClear" Grid.Column="1" Style="{StaticResource SecondaryBtn}"
                        Click="OnClearAllClick"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource BrushPanel}" Padding="12,8">
            <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}"
                     TextChanged="OnSearchChanged"/>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ListHost"/>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{StaticResource BrushPanel}" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnOpen" Style="{StaticResource SecondaryBtn}" Click="OnOpenClick"/>
                <Button x:Name="BtnDelete" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0" Click="OnDeleteClick"/>
                <TextBlock x:Name="EmptyNote" Style="{StaticResource BodyText}" Margin="14,0,0,0"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

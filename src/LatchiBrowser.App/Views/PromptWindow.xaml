<Window x:Class="LatchiBrowser.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LATCHI"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushWindow}"
        FlowDirection="RightToLeft">

    <StackPanel Margin="20">
        <TextBlock x:Name="PromptLabel" Style="{StaticResource BodyText}" Margin="0,0,0,6"/>
        <TextBlock x:Name="PromptNote" Style="{StaticResource BodyText}" FontSize="11.5"
                   Foreground="{StaticResource BrushMuted}" Margin="0,0,0,10" Visibility="Collapsed"
                   LineHeight="17"/>
        <TextBox x:Name="PromptBox" Style="{StaticResource FieldBox}" KeyDown="OnBoxKeyDown"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Left">
            <Button x:Name="BtnOk" Style="{StaticResource PrimaryBtn}" Click="OnOkClick"/>
            <Button x:Name="BtnCancel" Style="{StaticResource SecondaryBtn}" Margin="10,0,0,0" Click="OnCancelClick"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="LatchiBrowser.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="560" Height="680" MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushWindow}"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DialogHeader}">
            <TextBlock x:Name="HeaderTitle" Style="{StaticResource DialogHeaderText}"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,8,20,16">

                <!-- ═══ General ═══ -->
                <TextBlock x:Name="LblGeneral" Style="{StaticResource SectionHeader}"/>

                <TextBlock x:Name="LblLanguage" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbAr" GroupName="lang" Cursor="Hand" Checked="OnLangChecked"/>
                    <RadioButton x:Name="RbEn" GroupName="lang" Cursor="Hand" Margin="22,0,0,0" Checked="OnLangChecked"/>
                </StackPanel>

                <TextBlock x:Name="LblHome" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="HomeBox" Style="{StaticResource FieldBox}"/>

                <TextBlock x:Name="LblSearch" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbGoogle" GroupName="engine" Cursor="Hand" Checked="OnEngineChecked"/>
                    <RadioButton x:Name="RbBing" GroupName="engine" Cursor="Hand" Margin="22,0,0,0" Checked="OnEngineChecked"/>
                    <RadioButton x:Name="RbDdg" GroupName="engine" Cursor="Hand" Margin="22,0,0,0" Checked="OnEngineChecked"/>
                </StackPanel>

                <!-- ═══ Appearance ═══ -->
                <TextBlock x:Name="LblAppearance" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="ChkShowBar" Cursor="Hand"/>
                <TextBlock x:Name="LblBg" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnBgDark" Style="{StaticResource SecondaryBtn}" Click="OnBgDarkClick"/>
                    <Button x:Name="BtnBgImage" Style="{StaticResource SecondaryBtn}" Margin="10,0,0,0" Click="OnBgImageClick"/>
                    <Button x:Name="BtnBgRemove" Style="{StaticResource SecondaryBtn}" Margin="10,0,0,0" Click="OnBgRemoveClick"/>
                </StackPanel>
                <StackPanel x:Name="ColorRow" Orientation="Horizontal" Margin="0,10,0,0"/>

                <!-- ═══ Tabs ═══ -->
                <TextBlock x:Name="LblTabs" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="ChkRestoreTabs" Cursor="Hand"/>

                <!-- ═══ Privacy ═══ -->
                <TextBlock x:Name="LblPrivacy" Style="{StaticResource SectionHeader}"/>
                <Button x:Name="BtnClearHistory" Style="{StaticResource SecondaryBtn}" Click="OnClearHistoryClick"/>
                <Button x:Name="BtnClearCache" Style="{StaticResource SecondaryBtn}" Margin="0,10,0,0" Click="OnClearCacheClick"/>
                <Button x:Name="BtnClearCookies" Style="{StaticResource SecondaryBtn}" Margin="0,10,0,0" Click="OnClearCookiesClick"/>

                <!-- ═══ LATCHI AI ═══ -->
                <TextBlock x:Name="LblAi" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="ChkAi" Cursor="Hand" Checked="OnAiChecked" Unchecked="OnAiChecked"/>

                <TextBlock x:Name="LblModel" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ModelBox" Style="{StaticResource FieldBox}"/>

                <TextBlock x:Name="LblKey" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="KeyBox" Style="{StaticResource FieldBox}" PasswordChanged="OnKeyChanged"/>
                <TextBlock x:Name="KeyStatus" Style="{StaticResource BodyText}" FontSize="11.5"
                           Foreground="{StaticResource BrushMuted}" Margin="0,6,0,0"/>
                <Button x:Name="BtnRemoveKey" Style="{StaticResource SecondaryBtn}" Margin="0,10,0,0"
                        Click="OnRemoveKeyClick" HorizontalAlignment="Left"/>
                <TextBlock x:Name="KeyNote" Style="{StaticResource BodyText}" FontSize="11.5"
                           Foreground="{StaticResource BrushMuted}" Margin="0,12,0,0" LineHeight="18"/>

                <!-- ═══ About ═══ -->
                <TextBlock x:Name="LblAbout" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="AboutText" Style="{StaticResource BodyText}" LineHeight="19"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource BrushPanel}" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnSave" Style="{StaticResource PrimaryBtn}" Click="OnSaveClick"/>
                <Button x:Name="BtnCancel" Style="{StaticResource SecondaryBtn}" Margin="10,0,0,0"
                        Click="OnCancelClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

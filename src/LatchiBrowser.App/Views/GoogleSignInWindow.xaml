<Window x:Class="LatchiBrowser.App.Views.GoogleSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LATCHI Browser"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushWindow}"
        FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ welcome state ═══ -->
        <StackPanel x:Name="WelcomePanel" Grid.Row="0" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Width="400">
            <Image Source="/assets/appicon-256.png" Width="92" Height="92"
                   RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
            <TextBlock Text="LATCHI" FontSize="26" FontWeight="Bold" FontFamily="Segoe UI"
                       Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock x:Name="WelcomeTitle" FontSize="15" FontFamily="Segoe UI" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushText}" HorizontalAlignment="Center"
                       Margin="0,14,0,6"/>
            <TextBlock x:Name="WelcomeNote" FontSize="12" FontFamily="Segoe UI" TextWrapping="Wrap"
                       Foreground="{StaticResource BrushMuted}" HorizontalAlignment="Center"
                       Margin="14,0,14,26" LineHeight="19"/>

            <!-- Continue with Google — official white button + the Google G mark -->
            <Button x:Name="BtnGoogle" HorizontalAlignment="Center" Width="320" Height="50"
                    Cursor="Hand" Click="OnGoogleClick" FlowDirection="LeftToRight">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Canvas Width="24" Height="24" Margin="0,0,12,0">
                            <Path Fill="#FFEA4335" Data="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.69 1.28 6.6l3.99 3.1C6.21 6.86 8.87 4.75 12 4.75z"/>
                            <Path Fill="#FF4285F4" Data="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.13 2.74-2.39 3.58l3.86 3c2.26-2.09 3.55-5.17 3.55-8.82z"/>
                            <Path Fill="#FFFBBC05" Data="M5.26 14.29c-.24-.71-.38-1.47-.38-2.29s.14-1.57.38-2.29l-3.99-3.1C.63 8.23 0 10.05 0 12s.63 3.77 1.28 5.39l3.98-3.1z"/>
                            <Path Fill="#FF34A853" Data="M12 24c3.24 0 5.96-1.07 7.95-2.91l-3.86-3c-1.08.72-2.46 1.16-4.09 1.16-3.13 0-5.79-2.11-6.73-4.95l-3.99 3.1C3.26 21.31 7.31 24 12 24z"/>
                        </Canvas>
                        <TextBlock x:Name="GoogleLabel" FontSize="15.5" FontWeight="Medium"
                                   FontFamily="Segoe UI" Foreground="#FF3C4043" Text="Continue with Google"/>
                    </StackPanel>
                </Button.Content>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#FFFFFFFF" CornerRadius="8"
                                BorderBrush="#FFDADCE0" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF8F9FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF1F3F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock x:Name="SecurityNote" FontSize="11" FontFamily="Segoe UI" TextWrapping="Wrap"
                       Foreground="{StaticResource BrushMuted}" HorizontalAlignment="Center"
                       Margin="14,16,14,0" LineHeight="17"/>
        </StackPanel>

        <!-- ═══ real Google sign-in state (a real WebView2, real Google page) ═══ -->
        <Grid x:Name="SignInHost" Grid.Row="0" Visibility="Collapsed"
              Background="{StaticResource BrushContentBg}"/>

        <!-- ═══ signed-in confirmation ═══ -->
        <StackPanel x:Name="DonePanel" Grid.Row="0" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="54"
                       Foreground="#FF34A853" HorizontalAlignment="Center"/>
            <TextBlock x:Name="DoneText" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI"
                       Foreground="{StaticResource BrushText}" HorizontalAlignment="Center"
                       Margin="0,16,0,0"/>
            <Button x:Name="BtnContinue" Style="{StaticResource PrimaryBtn}" Width="200" Height="42"
                    Margin="0,24,0,0" Click="OnContinueClick" Cursor="Hand"/>
        </StackPanel>

        <!-- footer strip -->
        <Border Grid.Row="1" Background="{StaticResource BrushTabStrip}" Padding="14,8">
            <TextBlock x:Name="FooterNote" FontSize="11" FontFamily="Segoe UI" TextWrapping="Wrap"
                       Foreground="{StaticResource BrushMuted}" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>

<UserControl x:Class="LatchiBrowser.App.Views.StartPageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushContentBg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- centered block -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Width="680">

            <!-- logo row -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26">
                <Image Source="/assets/appicon-256.png" Width="64" Height="64"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="LATCHI" FontSize="24" FontWeight="Bold" FontFamily="Segoe UI"
                               Foreground="{StaticResource BrushAccent}"/>
                    <TextBlock Text="B R O W S E R" FontSize="9.5" FontWeight="SemiBold" FontFamily="Segoe UI"
                               Foreground="{StaticResource BrushMuted}"/>
                </StackPanel>
            </StackPanel>

            <!-- search box -->
            <Border Background="{StaticResource BrushField}" CornerRadius="24"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                    Height="50" Padding="18,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Grid Grid.Column="1">
                        <TextBlock x:Name="SearchHint" Text="…" VerticalAlignment="Center"
                                   FontSize="14" FontFamily="Segoe UI"
                                   Foreground="{StaticResource BrushMuted}" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource BrushText}" CaretBrush="{StaticResource BrushAccent}"
                                 SelectionBrush="#66E3B341" FontSize="14" FontFamily="Segoe UI"
                                 VerticalContentAlignment="Center" TextChanged="OnSearchTextChanged"
                                 KeyDown="OnSearchKeyDown"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- shortcuts -->
            <UniformGrid x:Name="TilesHost" Rows="2" Columns="6" Margin="0,30,0,6"/>
        </StackPanel>
    </Grid>
</UserControl>

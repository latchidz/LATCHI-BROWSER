<UserControl x:Class="LatchiBrowser.App.Views.StartPageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <!-- The LATCHI start page: search + editable Quick Access + favorites + recent.
         The background (dark / color / image) is applied by the window. -->
    <Grid x:Name="Root">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" Width="780" Margin="0,48,0,72">

                <!-- logo -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26">
                    <Image Source="/assets/appicon-256.png" Width="64" Height="64"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="LATCHI" FontSize="24" FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="#FFE3B341"/>
                        <TextBlock Text="B R O W S E R" FontSize="9.5" FontWeight="SemiBold" FontFamily="Segoe UI"
                                   Foreground="#FF93A0B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- search -->
                <Border Background="#C80D1626" CornerRadius="26"
                        BorderBrush="#33FFFFFF" BorderThickness="1" Height="52" Padding="18,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="#FF93A0B8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Grid Grid.Column="1">
                            <TextBlock x:Name="SearchHint" Text="…" VerticalAlignment="Center"
                                       FontSize="14" FontFamily="Segoe UI"
                                       Foreground="#FF93A0B8" IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                     Foreground="#FFEAeFF9" CaretBrush="#FFE3B341"
                                     SelectionBrush="#66E3B341" FontSize="14" FontFamily="Segoe UI"
                                     VerticalContentAlignment="Center" TextChanged="OnSearchTextChanged"
                                     KeyDown="OnSearchKeyDown"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Quick Access -->
                <TextBlock x:Name="QuickAccessTitle" FontSize="14" FontWeight="SemiBold"
                           FontFamily="Segoe UI" Foreground="#FFEAeFF9" Margin="4,30,4,10"/>
                <UniformGrid x:Name="TilesHost" Columns="6" FirstColumn="0"/>

                <!-- Favorites -->
                <TextBlock x:Name="FavoritesTitle" FontSize="13" FontWeight="SemiBold"
                           FontFamily="Segoe UI" Foreground="#FFEAeFF9" Margin="4,26,4,8" Visibility="Collapsed"/>
                <StackPanel x:Name="FavoritesHost" Orientation="Horizontal"/>

                <!-- Recently visited -->
                <TextBlock x:Name="RecentTitle" FontSize="13" FontWeight="SemiBold"
                           FontFamily="Segoe UI" Foreground="#FFEAeFF9" Margin="4,20,4,8" Visibility="Collapsed"/>
                <StackPanel x:Name="RecentHost" Orientation="Horizontal"/>
            </StackPanel>
        </ScrollViewer>

        <!-- customize (bottom corner) -->
        <Button x:Name="BtnCustomize" Style="{StaticResource SecondaryBtn}" Width="Auto" Height="32"
                FontSize="11.5" Padding="12,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,14" Cursor="Hand" Click="OnCustomizeClick"/>
    </Grid>
</UserControl>

<Window x:Class="LatchiBrowser.App.Views.LanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LATCHI Browser"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowActivated="True"
        Focusable="True"
        Background="{StaticResource BrushWindow}"
        FlowDirection="LeftToRight">

    <!-- First run, exactly once: pick a language → Start Browsing. Google sign-in is
         NOT required here — it lives inside the browser (Profile button) forever. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
            <Image Source="/assets/appicon-256.png" Width="96" Height="96"
                   RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
            <TextBlock Text="LATCHI" FontSize="30" FontWeight="Bold" FontFamily="Segoe UI"
                       Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock Text="B R O W S E R" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"
                       Foreground="{StaticResource BrushMuted}" HorizontalAlignment="Center"/>

            <TextBlock x:Name="QuestionText" FontSize="24" FontWeight="SemiBold" FontFamily="Segoe UI"
                       Foreground="{StaticResource BrushText}" HorizontalAlignment="Center"
                       Margin="0,34,0,18"/>

            <!-- language choice -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnArabic" Style="{StaticResource PrimaryBtn}" Width="220" Height="64"
                        FontSize="24" Click="OnArabicClick" Cursor="Hand">العربية</Button>
                <Button x:Name="BtnEnglish" Style="{StaticResource SecondaryBtn}" Width="220" Height="64"
                        FontSize="24" Margin="20,0,0,0" Click="OnEnglishClick" Cursor="Hand">English</Button>
            </StackPanel>

            <!-- start browsing (the ONLY required action) -->
            <Button x:Name="BtnStart" Style="{StaticResource PrimaryBtn}" Width="460" Height="58"
                    FontSize="20" Margin="0,34,0,0" Click="OnStartClick" Cursor="Hand"
                    HorizontalAlignment="Center"/>

            <!-- optional Google account — added from inside the browser, never forced -->
            <Button x:Name="BtnGoogle" Style="{StaticResource SecondaryBtn}" Width="460" Height="46"
                    FontSize="14" Margin="0,12,0,0" Click="OnGoogleClick" Cursor="Hand"
                    HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>

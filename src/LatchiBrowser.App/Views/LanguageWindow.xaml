<Window x:Class="LatchiBrowser.App.Views.LanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LATCHI Browser"
        Width="480" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BrushWindow}"
        FlowDirection="LeftToRight">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- logo -->
        <StackPanel Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <Image Source="/assets/appicon-256.png" Width="88" Height="88" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="LATCHI" FontSize="26" FontWeight="Bold" FontFamily="Segoe UI"
                       Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="B R O W S E R" FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI"
                       Foreground="{StaticResource BrushMuted}" HorizontalAlignment="Center"
                      />
        </StackPanel>

        <!-- question -->
        <TextBlock x:Name="QuestionText" Grid.Row="1" FontSize="21" FontWeight="SemiBold"
                   FontFamily="Segoe UI" Foreground="{StaticResource BrushText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- the two languages -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Top" Margin="0,6,0,0">
            <Button x:Name="BtnArabic" Style="{StaticResource PrimaryBtn}" Width="170" Height="52"
                    FontSize="19" Click="OnArabicClick" Cursor="Hand">العربية</Button>
            <Button x:Name="BtnEnglish" Style="{StaticResource SecondaryBtn}" Width="170" Height="52"
                    FontSize="19" Margin="18,0,0,0" Click="OnEnglishClick" Cursor="Hand">English</Button>
        </StackPanel>
    </Grid>
</Window>
